	(text
		"PCIe GPU test rig - power box wiring"
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects (font (size 3.0 3.0) bold) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000038")
	)
	(text
		"Rev A  2026-09-27.  Meter terminals read off the PZEM-031 case label (top->bottom 1..4)."
		(exclude_from_sim no)
		(at 20.32 30.48 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000039")
	)
	(text
		"M1 PZEM-031:  1 = LOAD -   2 = DC IN -   3 = DC IN +   4 = LOAD +."
		(exclude_from_sim no)
		(at 142.24 66.04 0)
		(effects (font (size 1.3 1.3)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000040")
	)
	(text
		"Shunt is internal between 2 and 1; + passes straight through 3 -> 4."
		(exclude_from_sim no)
		(at 142.24 69.85 0)
		(effects (font (size 1.3 1.3)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000041")
	)
	(text
		"Fed from the switched side (3 = 12V_SW) so it powers down with the rig. Range 8-100 V, 0-20 A."
		(exclude_from_sim no)
		(at 142.24 73.66 0)
		(effects (font (size 1.3 1.3)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000042")
	)
	(text
		"SW1 (Ampper 3-pin): A = supply +, B = load +, yellow = LED - to GND_IN. Dot lights when ON."
		(exclude_from_sim no)
		(at 83.82 96.52 0)
		(effects (font (size 1.3 1.3)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000043")
	)
	(text
		"J3 PROBE GND ties to GND_OUT (LOAD -, after the shunt), not GND_IN - otherwise the probe reference shifts by the shunt drop under load."
		(exclude_from_sim no)
		(at 20.32 152.4 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000044")
	)
	(text
		"F1 in the +12 V input line ahead of the switch. 15 A fast-blow; never above 20 A (meter / switch limit)."
		(exclude_from_sim no)
		(at 20.32 157.48 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000045")
	)
	(text
		"Internal bus 12 AWG tinned copper. Pigtail = Amangny 18 AWG with the female end cut off: 3 yellow = +12 V, 5 black = GND. Zip tie inside the wall as strain relief."
		(exclude_from_sim no)
		(at 20.32 162.56 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000046")
	)
	(text
		"Whole path rated 20 A -> ~240 W. Diagnostic rig for boot stages and rail checks, not a load tester."
		(exclude_from_sim no)
		(at 20.32 167.64 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000047")
	)
	(text
		"Panels:  REAR = J1, J2, F1.   TOP deck = SW1, M1 (+ riser dock).   RIGHT wall = J4 pigtail exit, J3.   FRONT = cord drawer only."
		(exclude_from_sim no)
		(at 20.32 175.26 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000048")
	)
