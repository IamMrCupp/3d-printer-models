	(text
		"PCIe GPU test rig - power box wiring"
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects (font (size 3.0 3.0) bold) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000039")
	)
	(text
		"Rev B  2026-09-27.  Explicit wiring; meter terminals read off the PZEM-031 case label (top->bottom 1..4)."
		(exclude_from_sim no)
		(at 20.32 27.94 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000040")
	)
	(text
		"M1 PZEM-031:  shunt is internal between 2 (DC IN-) and 1 (LOAD-);  + passes straight through 3 -> 4.  Fed from the switched side so it sleeps with the rig.  8-100 V, 0-20 A."
		(exclude_from_sim no)
		(at 20.32 106.68 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000041")
	)
	(text
		"SW1 Ampper 3-pin:  A = supply +,  B = load +,  yellow = LED -.  LED return goes to the INPUT negative so its current stays out of the reading."
		(exclude_from_sim no)
		(at 20.32 111.76 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000042")
	)
	(text
		"J3 PROBE GND = the OUTPUT negative (LOAD-, after the shunt).  Never the input negative: the shunt drop would shift the probe reference under load."
		(exclude_from_sim no)
		(at 20.32 116.84 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000043")
	)
	(text
		"F1 in the + input line ahead of the switch.  15 A fast-blow, never above 20 A (meter / switch limit).  Whole path ~240 W: boot stages and rail checks, not a load tester."
		(exclude_from_sim no)
		(at 20.32 121.92 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000044")
	)
	(text
		"Internal bus 12 AWG tinned copper.  J4 is the cut Amangny cable, 18 AWG: 5 black = GND, 3 yellow = +12 V; exits the right wall, zip tie inside as strain relief."
		(exclude_from_sim no)
		(at 20.32 127.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000045")
	)
	(text
		"Panels:  REAR = J1, J2, F1.    TOP deck = SW1, M1, J3 (+ riser dock).    RIGHT wall = J4 pigtail exit.    FRONT = cord drawer only."
		(exclude_from_sim no)
		(at 20.32 134.62 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000046")
	)
