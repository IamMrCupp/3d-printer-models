	)
	(text
		"top deck"
		(exclude_from_sim no)
		(at 170.18 156.21 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000089")
	)
	(text
		"M1: the shunt is internal between 2 (DC IN-) and 1 (LOAD-). Input negative goes to 2, never to W1 -"
		(exclude_from_sim no)
		(at 20.32 163.82999999999998 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000090")
	)
	(text
		"    on the bus it bypasses the shunt and the meter reads 0 A."
		(exclude_from_sim no)
		(at 20.32 167.64 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000091")
	)
	(text
		"SW1: A from M1.4, B to the outputs, yellow to ground. Never swap B and yellow: dead short when switched on."
		(exclude_from_sim no)
		(at 20.32 171.45 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000092")
	)
	(text
		"    Beep the pins before crimping."
		(exclude_from_sim no)
		(at 20.32 175.26 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000093")
	)
	(text
		"W1 ports: 5 = LOAD-, 4 = RISER -, 3 = CARD -, 2 = OUT - post, 1 = PROBE GND. LED - rides on the OUT - post."
		(exclude_from_sim no)
		(at 20.32 179.07 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000094")
	)
	(text
		"Supply: OWON at 12.0 V, OVP 12.6 V, 6 A current limit (the working max). F1 8 A fast 5x20. J4 is optional."
		(exclude_from_sim no)
		(at 20.32 182.88 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6b2f0c1e-2000-4000-8000-000000000095")
	)
